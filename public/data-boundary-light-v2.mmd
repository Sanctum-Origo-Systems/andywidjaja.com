flowchart LR
    subgraph work["Work Device · private"]
        direction TB
        msg["Messages\nMeetings"]
        beliefs["Belief Graph"]
        draft["Issue Drafter\n+ Sanitizer"]
        msg --> beliefs --> draft
    end

    draft --> gate1["Human\nGate"]
    gate1 -->|"sanitized\nissue"| issue["GitHub\nIssue"]
    issue --> gate2["Human\nGate"]
    gate2 --> triage

    subgraph vps["VPS · public repo only"]
        direction TB
        triage["Triage"]
        builder["Builder"]
        verify["Verify +\nReview"]
        triage --> builder --> verify
    end

    verify --> merge["Merged"]

