---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<section class="border-t border-border pt-10">
  <div class="flex items-baseline justify-between gap-4 mb-6">
    <a href="/blog" class="text-text-primary font-semibold text-xl uppercase tracking-wide hover:text-accent transition-colors">
      Writing
    </a>
    <a href="/blog" class="text-text-secondary hover:text-accent transition-colors font-mono text-sm whitespace-nowrap">
      all posts &rarr;
    </a>
  </div>
  <div class="space-y-3">
    {posts.map(post => (
      <a href={`/blog/${post.id}`} class="block group bg-surface border border-border rounded-md p-4 hover:border-accent transition-colors">
        <time class="font-mono text-text-secondary text-xs">{post.data.date.toISOString().split('T')[0]}</time>
        <h3 class="font-semibold text-text-primary group-hover:text-accent transition-colors mt-1">{post.data.title}</h3>
        <p class="text-text-secondary text-sm mt-1">{post.data.description}</p>
      </a>
    ))}
  </div>
</section>
