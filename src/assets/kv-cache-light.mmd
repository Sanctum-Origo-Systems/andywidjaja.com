%%{init: {"themeVariables": {"lineColor": "#1f2328"}, "flowchart": {"wrappingWidth": 520}}}%%
flowchart TB
    subgraph prefill[" "]
        direction TB
        PH["<b>PREFILL:</b> one parallel pass over the prompt"]
        PH ~~~ P
        P["prompt tokens<br/>[t1][t2][t3] ... [t40,000]"]
        subgraph kvRow[" "]
            direction LR
            KV1["KV cache<br/>keys + values for t1..t40K"]
            CP["cached prefix: nearly free"]
        end
        P -->|"all at once, as large matrix multiplications"| kvRow
        KV1 ~~~ CP
        PC["cost: fast per token"]
        kvRow ~~~ PC
    end

    subgraph decode[" "]
        direction TB
        DH["<b>DECODE:</b> one token per pass"]
        DH ~~~ cacheRow
        subgraph cacheRow[" "]
            direction LR
            KVC["KV cache t1 .. t40K &nbsp;│ +1 │ +1 │ ... │"]
            NE["one new entry per step"]
        end
        KVC ~~~ NE
        subgraph chainRow[" "]
            direction LR
            T1["token 1"] --> T2["token 2"] --> T3["token 3"] --> T4["..."] --> TN["token N"]
        end
        cacheRow -->|"every step reads the weights + the whole cache"| chainRow
        DC["(~6 to 9 ms per token, every token, in order)<br/>cost: N tokens × ITL (inter-token latency). This is the wall clock."]
        chainRow ~~~ DC
    end

    prefill ~~~ decode

